# Copy to .env on the Pi (never commit the real file).
# Vibe plan key: vibe --setup, or Code > Extensions > Advanced in Vibe.
VIBE_KEY=
# Optional pay-as-you-go fallback key from Mistral AI Studio.
STUDIO_API_KEY=
# REQUIRED when the container binds a non-loopback address (it does).
# Generate: openssl rand -hex 24   /   python3 -c "import secrets;print(secrets.token_hex(24))"
GATEWAY_KEY=
# Anti-ban guards: polite caps so a runaway client cannot hammer the plan.
RATE_LIMIT_PER_MIN=120
MAX_CONCURRENT=6
# Server-side web search (Variant B): gateway executes the model's
# web_search function call itself. Providers: ddg (free, no key),
# tavily / serper (need SEARCH_API_KEY).
WEB_SEARCH=1
SEARCH_PROVIDER=ddg
SEARCH_API_KEY=
