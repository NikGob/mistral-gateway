# Copy to gateway.env and uncomment what you need.
# By default the Vibe plan key is read from ~/.vibe/.env (written by `vibe --setup`).
# VIBE_KEY=
# STUDIO_API_KEY=
# GATEWAY_KEY=
# PORT=8788
# DATA_DIR=          (state dir for usage.db / pool_state.json; Docker sets /data)
# MAX_REQUEST_BYTES=10485760
